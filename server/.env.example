# ============================================================
# MORA Industries — questionnaire intake service
# Copy to .env and fill in. Keep .env out of version control.
# ============================================================

# ---- Where the service listens ----
# Bind to loopback and let nginx terminate TLS in front of it.
HOST=127.0.0.1
PORT=4010

# ---- Where the answers go ----
MAIL_TO=Business@omar-abuelsoud.com
MAIL_FROM=MORA Industries <no-reply@omar-abuelsoud.com>
# MAIL_CC=analysis@omar-abuelsoud.com

# Send the client a confirmation with a copy of their answers.
CONFIRM_CLIENT=true

# ---- SMTP ----
# Any provider works. Port 465 needs SMTP_SECURE=true; 587 needs false.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@omar-abuelsoud.com
SMTP_PASS=change-me

# ---- Storage ----
# Every submission is written here before the email is attempted,
# so a mail failure never loses a client's answers.
ARCHIVE_DIR=/var/lib/mora-questionnaire/submissions

# ---- Abuse controls ----
# Only needed when the page is served from a different origin than
# the service. Same-origin (the nginx snippet) needs none.
# ALLOWED_ORIGINS=https://moraindustries.com,https://www.moraindustries.com
MIN_SECONDS=20
MAX_PER_HOUR=6
